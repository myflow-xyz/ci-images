{
  "schema_version": 1,
  "endpoint": "unix:///var/run/docker.sock",
  "expected_daemon_id": "REPLACE_WITH_DAEMON_ID",
  "image_scope": {
    "mode": "allowlist",
    "repositories": [],
    "references": [],
    "ids": []
  },
  "protected": {
    "container_ids": [],
    "network_ids": [],
    "image_ids": [],
