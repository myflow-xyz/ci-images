[Unit]
Description=Guarded CI Docker maintenance (%i)
Requisite=docker.service
After=docker.service
ConditionPathIsSocket=/var/run/docker.sock

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/local/libexec/ci-utils/ci-docker-maintenance --config /etc/ci-utils/host.json apply --profile %i --wait 15m
TimeoutStartSec=40min
TimeoutStopSec=30s
Restart=no
KillMode=control-group
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ci-utils
RestrictAddressFamilies=AF_UNIX
MemoryMax=768M
TasksMax=128
StandardOutput=journal
StandardError=journal
