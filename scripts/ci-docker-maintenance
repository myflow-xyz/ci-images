#!/usr/bin/env python3
"""Run from the repository or a root-owned host adapter installation."""

import pathlib
import sys

sys.dont_write_bytecode = True
here = pathlib.Path(__file__).resolve().parent
library = here / "ci-utils/lib"
sys.path[:0] = [str(here), str(library), str(library / "ci_utils")]

from ci_docker_maintenance import main

raise SystemExit(main())
