root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

# Keep Markdown prose on one source line; use editor soft wrapping.
[*.md]
indent_style = space
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 4

[*.sh]
indent_style = tab

[images/{common/fetch-verified,playwright/check-version}]
indent_style = tab
