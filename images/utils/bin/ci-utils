#!/usr/bin/env python3
"""Discover the utility image's maintained commands without daemon access."""

import argparse

parser = argparse.ArgumentParser(
    prog="ci-utils",
    description="Reusable CI operations tools. Invoke each command directly.",
    formatter_class=argparse.RawDescriptionHelpFormatter,
    epilog="Available commands:\n"
    "  ci-docker-cleanup check|plan|apply|version (default: plan)\n"
    "  ci-remove-images --versions X.Y.Z[,X.Y.Z] [--apply] (default: dry-run)",
)
parser.add_argument("operation", nargs="?", choices=("help",), default="help")
parser.parse_args()
parser.print_help()
